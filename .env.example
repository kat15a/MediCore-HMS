# =============================================================================
# docker-compose environment variables
# Copy this file to .env in the project root before running `docker compose up`.
# =============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=hms_db
DB_USERNAME=root
DB_PASSWORD=root123
MYSQL_EXPOSED_PORT=3306

# --- Backend ---
SPRING_PROFILES_ACTIVE=prod
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_256_bit_secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
BACKEND_EXPOSED_PORT=8080

# --- Frontend / CORS ---
# Should match wherever the frontend container is actually reachable.
FRONTEND_EXPOSED_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081

# --- Mail (used for verification / reset-password emails) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# --- AI Provider: gemini | openai ---
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
